{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["client/src/**", "server/**", "shared/**", "scripts/e2e/**", "vite.config.ts", "!**/*.md", "!**/dist", "!**/node_modules"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": { "useButtonType": "off", "useAriaPropsSupportedByRole": "off", "useSemanticElements": "off", "noAutofocus": "off" },
      "style": { "noNonNullAssertion": "off", "noDescendingSpecificity": "off" },
      "suspicious": {
        "noControlCharactersInRegex": "off",
        "noArrayIndexKey": "off",
        "useIterableCallbackReturn": "off",
        "noExplicitAny": "off"
      },
      "correctness": { "useExhaustiveDependencies": "off", "noVoidTypeReturn": "off", "useHookAtTopLevel": "off" },
      "performance": { "useDomNodeTextContent": "off" }
    }
  },
  "assist": { "enabled": false }
}
